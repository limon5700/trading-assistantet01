<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed "Show less" state: compact circle. Tap anywhere for the signal. -->
    <LinearLayout
        android:id="@+id/bubble_view"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/overlay_bubble"
        android:clickable="true"
        android:contentDescription="Tap to hear the latest trading signal"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="7dp">

        <TextView
            android:id="@+id/bubble_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIN"
            android:textColor="#2563EB"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/signal_wait"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="WAIT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="TAP&#10;FOR SIGNAL"
            android:textColor="#2563EB"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expand_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Show more"
            android:paddingTop="1dp"
            android:text="⌃ show more"
            android:textColor="#64748B"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded "Show more" state: full structured signal card. -->
    <LinearLayout
        android:id="@+id/expanded_view"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/overlay_mode"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="BIN"
                android:textColor="#1D4ED8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="AI TRADING"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/show_less_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Show less"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="⌄ show less"
                android:textColor="#2563EB"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Stop the widget"
                android:paddingStart="4dp"
                android:paddingEnd="2dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/signal_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/signal_wait"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="WAIT"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/confidence_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="confidence"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/asset_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Asset: —"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/candle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Candle: —"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timing_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Duration: —"
            android:textColor="#334155"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/levels_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reason_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Waiting for the first chart analysis…"
            android:textColor="#475569"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/voice_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="JSON"
            android:textColor="#94A3B8"
            android:textSize="8sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/overlay_json"
            android:padding="6dp">

            <TextView
                android:id="@+id/json_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="{}"
                android:textColor="#1E293B"
                android:textSize="8.5sp" />
        </ScrollView>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Starting…"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deliver_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/overlay_button"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Get signal"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analyze_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/overlay_button"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Rescan"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

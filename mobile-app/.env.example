# Backend base URL baked into the app build. It is read from
# `import.meta.env.VITE_API_BASE_URL` and cannot be edited inside the app.
# Keep this a public URL: the Gemini key stays on the server.
VITE_API_BASE_URL=https://ai-trading-api.onrender.com

# Shown in the Settings footer.
VITE_APP_VERSION=1.0.1

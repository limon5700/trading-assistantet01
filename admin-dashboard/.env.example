# Leave empty when the dashboard is served behind the same origin / dev proxy.
# Set it to the full backend origin (e.g. https://api.example.com) when the API
# is hosted separately.
VITE_API_BASE_URL=

# Only used by `npm run dev` / `npm run preview` to proxy /api requests.
VITE_DEV_API_TARGET=http://127.0.0.1:4000

# Comma-separated extra hostnames allowed by the Vite dev server (for tunnels).
VITE_ALLOWED_HOSTS=

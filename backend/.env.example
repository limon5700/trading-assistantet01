# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000

# Comma separated list of allowed browser origins for the admin dashboard,
# e.g. https://admin.example.com. Leave empty to reflect the request origin
# (convenient for local development only).
CORS_ORIGINS=

# Set to "true" when served over HTTPS so the auth cookie gets the Secure flag.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Admin credentials (JWT)
# ---------------------------------------------------------------------------
# Long random string, e.g. `openssl rand -hex 48`.
JWT_SECRET=change-me-to-a-long-random-secret
# JWT lifetime, e.g. 12h, 1d.
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---------------------------------------------------------------------------
# Google Gemini (SERVER SIDE ONLY - never ship this key to a browser or app)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard cap for the amount of active knowledge text injected per request.
MAX_KNOWLEDGE_CHARS=120000
# Timeout for a single Gemini request, in milliseconds.
GEMINI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# "mysql" or "sqlite". When omitted the server falls back to SQLite.
DB_CLIENT=sqlite

# --- MySQL (used when DB_CLIENT=mysql) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ai_trading

# --- SQLite fallback (used when DB_CLIENT=sqlite) ---
# Relative paths resolve against the backend folder.
SQLITE_PATH=./data/ai_trading.db

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Maximum accepted PDF size in megabytes.
MAX_UPLOAD_MB=25

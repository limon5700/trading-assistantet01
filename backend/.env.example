# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000

# Comma separated list of allowed browser origins for the admin dashboard,
# e.g. https://admin.example.com. Leave empty to reflect the request origin
# (convenient for local development only).
CORS_ORIGINS=

# Set to "true" when served over HTTPS so the auth cookie gets the Secure flag.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Admin credentials (JWT)
# ---------------------------------------------------------------------------
# Long random string, e.g. `openssl rand -hex 48`.
JWT_SECRET=change-me-to-a-long-random-secret
# Admin JWT lifetime, e.g. 12h, 1d.
JWT_EXPIRES_IN=12h
# App user JWT lifetime, e.g. 30d.
USER_JWT_EXPIRES_IN=30d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---------------------------------------------------------------------------
# Google Gemini (SERVER SIDE ONLY - never ship this key to a browser or app)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# The configured model is tried first; if it fails (retired, overloaded, quota,
# bad JSON) the server routes the same request through the other available
# Gemini models (Lite/Flash/Pro) automatically. This caps how many are tried.
GEMINI_MAX_MODEL_ATTEMPTS=8
# Per-model timeout in milliseconds; the next model gets the remaining budget.
GEMINI_ATTEMPT_TIMEOUT_MS=20000
# Hard cap for the amount of active knowledge text injected per request.
MAX_KNOWLEDGE_CHARS=120000
# Timeout for a single Gemini request, in milliseconds.
GEMINI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# "mysql" (primary, persistent) or "sqlite" (offline development / tests).
# MySQL is the default. All users, plans, activation codes, trade settings,
# branding and BINARY/FOREX knowledge items are stored there.
DB_CLIENT=mysql

# --- MySQL (used when DB_CLIENT=mysql) ---
# With docker compose the host is `mysql` and the credentials come from the
# root .env file (see .env.docker.example).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ai_trading
# The API retries the initial connection until MySQL finishes its first boot.
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_RETRY_MS=2000

# --- SQLite fallback (used when DB_CLIENT=sqlite) ---
# Relative paths resolve against the backend folder.
SQLITE_PATH=./data/ai_trading.db

# ---------------------------------------------------------------------------
# Crypto (USDT) payments
# ---------------------------------------------------------------------------
# The network, receiving wallet and explorer keys are normally saved from the
# admin dashboard (Settings page). These variables act as fallbacks for
# self-hosted deployments and for direct BSC RPC access.
BSC_RPC_URL=
# Optional BscScan API key used when the public BSC RPC endpoints are unavailable.
BSCSCAN_API_KEY=
# Optional TronGrid API key used for TRC20 USDT verification.
TRONGRID_API_KEY=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Maximum accepted PDF size in megabytes.
MAX_UPLOAD_MB=25

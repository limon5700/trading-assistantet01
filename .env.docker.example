# Copy to .env (next to docker-compose.yml) and replace every value.
# Never commit the real .env file.
#
#   cp .env.docker.example .env
#   docker compose up -d --build

# --- MySQL (persisted in the mysql_data volume) --------------------------
MYSQL_DATABASE=ai_trading
MYSQL_USER=trading_app
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
# Host port for direct MySQL access; remove the mapping in docker-compose.yml
# if the database must not be reachable from outside the Docker network.
MYSQL_PORT=3306

# --- API -----------------------------------------------------------------
BACKEND_PORT=4000
# openssl rand -hex 48
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Public origin of this API, used to build absolute branding/PDF URLs.
PUBLIC_BASE_URL=https://api.example.com
# Comma separated allowed browser origins for the admin dashboard.
CORS_ORIGINS=https://admin.example.com
COOKIE_SECURE=true
MAX_UPLOAD_MB=25
TZ=UTC
